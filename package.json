{
  "name": "sadaqah-path",
  "version": "2.1.2",
  "description": "Sadaqah Path - multilingual desktop app with official nature background",
  "main": "main.js",
  "author": "Ebrahim Tayfour / ET TECH",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "setup:x64": "electron-builder --win nsis --x64",
    "setup:ia32": "electron-builder --win nsis --ia32",
    "pack:x64": "electron-builder --dir --win --x64",
    "pack:ia32": "electron-builder --dir --win --ia32"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.ettech.sadaqahpath",
    "productName": "Sadaqah Path",
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "i18n.js",
      "app.js",
      "assets/**/*",
      "data/**/*",
      "LICENSE",
      "README_AR.md",
      "PRIVACY_AR.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "artifactName": "Sadaqah-Path-${version}-Child-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sadaqah Path",
      "runAfterFinish": false,
      "unicode": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "artifactName": "Sadaqah-Path-${version}-Child-${arch}.${ext}"
}